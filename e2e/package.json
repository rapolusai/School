{
  "name": "akshara-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for Akshara (Playwright) against a running frontend + backend.",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:responsive": "playwright test responsive.spec.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
