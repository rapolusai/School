# Local development only. Copy to .env (which git ignores) and change every value.
# Real environments read these from AWS Secrets Manager; never reuse local values there.
POSTGRES_PASSWORD=change-me-postgres
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional: creates a Super Admin on first start.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Optional: creates the "demo" school with one person per role (password at least 10 characters).
DEMO_ENABLED=true
DEMO_PASSWORD=
