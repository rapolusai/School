# Production settings for the single-server setup (docker-compose.prod.yml). Copy to .env, never commit .env.
#   ./generate-secrets.sh        creates .env from this file with fresh random secrets (chmod 600)
# Then fill in every value marked REQUIRED below. Runbook: docs/runbooks/single-server.md.

# --- Site -------------------------------------------------------------------------------------------------------
# REQUIRED. Host name the app is served on; its DNS A record points at the server's Elastic IP.
# The root domain (rapolu.in) stays free for a landing site; set APP_DOMAIN=rapolu.in to serve the app there instead.
APP_DOMAIN=app.rapolu.in
# REQUIRED. Email for the Let's Encrypt account (expiry and problem notices).
ACME_EMAIL=owner@rapolu.in
# Leave unset in production. "internal" makes Caddy use a self-signed certificate (local tests only).
#CADDY_TLS=internal
# Browser origins allowed to call the API. Defaults to https://$APP_DOMAIN; list more with commas.
#ALLOWED_ORIGINS=https://app.rapolu.in

# --- Database (generated) ---------------------------------------------------------------------------------------
# postgres: superuser, used only by backups/restores. akshara_owner: migrations. akshara_app: the API.
POSTGRES_PASSWORD=__GENERATE__
DB_OWNER_PASSWORD=__GENERATE__
DB_APP_PASSWORD=__GENERATE__
# Connections the API keeps open (PostgreSQL allows 40 in total; see the compose file).
#DB_POOL_SIZE=10

# --- Sign-in (generated) ----------------------------------------------------------------------------------------
# HMAC key that signs access tokens. Changing it signs everyone out.
JWT_SECRET=__GENERATE__

# --- First Super Admin ------------------------------------------------------------------------------------------
# REQUIRED for the first start: the API creates this Super Admin if no admin with this email exists. Sign in, change
# the password in the app, then you may empty PLATFORM_ADMIN_PASSWORD here (it is only read when the admin is missing).
PLATFORM_ADMIN_EMAIL=owner@rapolu.in
PLATFORM_ADMIN_PASSWORD=__GENERATE__
PLATFORM_ADMIN_NAME=Platform Admin

# --- AWS (the instance role provides credentials; never put access keys here) ------------------------------------
AWS_REGION=ap-south-1
# Uploaded files: "s3" (recommended: versioned bucket, kept out of the database and its backups) or "database"
# (files inside PostgreSQL; then the daily pg_dump covers them too, but the database and backups grow).
FILES_STORE=s3
# REQUIRED when FILES_STORE=s3: the files bucket (private, versioned) the instance role may read and write.
FILES_S3_BUCKET=akshara-prod-files-REPLACE
# Set to true for ONE start to copy files already stored in the database to S3, then set back to false.
FILES_COPY_TO_S3=false

# --- Email ------------------------------------------------------------------------------------------------------
# "simulated" (recorded in the message log, never sent) until SES is verified for rapolu.in and out of the sandbox;
# then "ses" (the instance role needs ses:SendEmail).
EMAIL_SENDER=simulated
EMAIL_FROM=no-reply@rapolu.in
# Optional SES configuration set (bounces and complaints suppression).
EMAIL_SES_CONFIGURATION_SET=

# --- School fee payments (parents paying schools) ---------------------------------------------------------------
# "sandbox" (no real money) until Razorpay is approved; then "razorpay" with all three keys below.
PAYMENTS_GATEWAY=sandbox
# Signs sandbox payments and webhooks (generated). Also used by the billing sandbox below.
PAYMENTS_SANDBOX_SECRET=__GENERATE__
# Webhook URL to configure in Razorpay: https://<APP_DOMAIN>/api/public/payments/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Subscription billing (schools paying Akshara: Akshara's OWN Razorpay account, separate keys) ---------------
# "off" until Akshara's live Razorpay keys are set: schools pay by bank transfer and the Super Admin records it.
# Never "sandbox" in production: it lets a school mark its own invoice paid without any money.
BILLING_PAYMENTS_GATEWAY=off
# Webhook URL: https://<APP_DOMAIN>/api/public/billing/webhook/razorpay
BILLING_RAZORPAY_KEY_ID=
BILLING_RAZORPAY_KEY_SECRET=
BILLING_RAZORPAY_WEBHOOK_SECRET=
# Seller details printed on GST invoices. REQUIRED before the first real invoice (defaults are samples).
BILLING_SELLER_NAME=Akshara School Cloud (sample seller)
BILLING_SELLER_ADDRESS=Sample address - set BILLING_SELLER_ADDRESS
BILLING_SELLER_STATE_CODE=36
BILLING_SELLER_GSTIN=36XXXXX0000X1ZX
BILLING_INVOICE_PREFIX=AKS

# --- Backups (backup/backup.sh) ---------------------------------------------------------------------------------
# REQUIRED for off-server copies: bucket for the daily database dumps (30-day lifecycle rule on the bucket).
# Empty = dumps stay on this server only (the script warns).
BACKUP_S3_BUCKET=akshara-prod-backups-REPLACE
# Where dumps are kept on this server, and for how many days.
BACKUP_DIR=/var/backups/akshara
BACKUP_KEEP_DAYS=7

# --- Ports (only change for local tests) ------------------------------------------------------------------------
#HTTP_PORT=80
#HTTPS_PORT=443
# Private range of the internal Docker network (the API trusts X-Forwarded-For only from private addresses).
#DOCKER_SUBNET=172.28.0.0/24

# Demo data is always off in production (the compose file sets DEMO_ENABLED=false).
# The running image tag (APP_TAG) lives in release.env, written by deploy.sh.
